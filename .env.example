# Optional: sample CSV works with no .env file.
DATA_SOURCE=csv
CSV_PATH=data/sample.csv
CACHE_SECONDS=60
# Absolute path to a server-side service-account JSON file, kept outside Git.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_NAME/private/whcc-service-account.json
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEET_RANGE="'Schedule'!A1:J500"
# Map internal field names to exact column headers. Unspecified keys use defaults.
FIELD_MAPPING_JSON={}
# These four blanks are marked "Needs assignment"; optional fields can stay blank.
REQUIRED_ASSIGNMENTS=discussion_leader,host,food,childcare
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H:%M

# Optional two-row calendar layout (defaults above remain the simple CSV demo).
SHEET_LAYOUT=table
# When selecting calendar mode, configure the year, time, headers, and range:
# SHEET_LAYOUT=calendar
# GOOGLE_SHEET_RANGE="'Calendar'!A1:J200"
# FIELD_MAPPING_JSON={"host":"Host","food":"Dinner","discussion_leader":"Discussion","childcare":"Childcare","notes":"Event notes"}
# CALENDAR_START_YEAR=2030
# CALENDAR_START_MONTH=9
# CALENDAR_START_TIME=18:00
# CALENDAR_DATE_COLUMN=A
# CALENDAR_EVENT_COLUMN=D
# CALENDAR_END_MARKER=Roles
# CALENDAR_TOPIC_LABELS_JSON=["Sermon Series"]
# CALENDAR_CANCELED_DATES=

# Household attendance is stored separately from the read-only Google Sheet.
RSVP_DATABASE=private/attendance.sqlite3
RSVP_SECRET_FILE=private/session.key
RSVP_COOKIE_NAME=whcc_household
# true only when serving over HTTPS; keep false for local HTTP testing.
COOKIE_SECURE=false
# Production: configure a long random SECRET_KEY through server secrets.
# If absent locally, the app generates and retains private/session.key.


# Admin editing works locally without Google. Set a password with the Flask CLI.
SCHEDULE_EDITING=true
ADMIN_PASSWORD_FILE=private/admin-password.hash
# Optional: configure ADMIN_PASSWORD_HASH through server secrets instead.
# Enable only for a Google source after granting the service account Editor access.
BACKEND_SHEET_ENABLED=false
BACKEND_SHEET_TITLE=App Backend

# Local defaults; Cloud Run uses APP_ENV=production and runtime ADC (no key path).
APP_ENV=development
TRUST_PROXY=false
# Optional local group gate: generate a hash with tools/create_deployment_secrets.py.
# GROUP_ACCESS_PASSWORD_HASH=PLACEHOLDER_PASSWORD_HASH
# SECRET_KEY=PLACEHOLDER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Production requires both password hashes and a stable SECRET_KEY via Secret Manager.
