# Optional: sample CSV works with no .env file.
DATA_SOURCE=csv
CSV_PATH=data/sample.csv
CACHE_SECONDS=60
# Absolute path to a server-side service-account JSON file, kept outside Git.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/YOUR_NAME/private/whcc-service-account.json
GOOGLE_SHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEET_RANGE='Schedule'!A1:J500
# Map internal field names to exact column headers. Unspecified keys use defaults.
FIELD_MAPPING_JSON={}
# These four blanks are marked "Needs assignment"; optional fields can stay blank.
REQUIRED_ASSIGNMENTS=discussion_leader,host,food,childcare
DATE_FORMAT=%Y-%m-%d
TIME_FORMAT=%H:%M
